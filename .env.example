# Copy to .env and fill in. Never commit .env.
# An agent whose key is missing simply stays idle.

# Codex: an API key. (Subscription login instead: mount your ~/.codex/auth.json
# into the codex container at /home/node/.codex/auth.json. Untested.)
OPENAI_API_KEY=

# Claude Code: an API key, or a subscription token from `claude setup-token`. One is enough.
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

# Mistral Vibe
MISTRAL_API_KEY=

# goose: any supported provider and model, plus that provider's API key variable
GOOSE_PROVIDER=
GOOSE_MODEL=

# Database password. Set your own before first start; it is fixed once the volume exists.
# Use letters and digits only (it becomes part of a connection URL).
POSTGRES_PASSWORD=

# Optional tuning
# MAX_ATTEMPTS=3              # tries per topic and agent before giving up for the edition
# RETRY_BASE_SECONDS=120      # pause before the 2nd try; doubles each time
# MAX_TOPICS_PER_EDITION=10   # hard cap of topics one agent starts per edition
# MAX_TURNS=40            # upper limit of agent turns per topic (Claude Code, Vibe)
# CODEX_ARGS=             # extra flags for one agent's CLI; likewise CLAUDE_ARGS, VIBE_ARGS, GOOSE_ARGS
# WORKER_INTERVAL=300     # seconds between a collector's looks at the job list
# PIPELINE_INTERVAL=600   # seconds between pipeline cycles
# CHECK_LINKS=1           # 0 = do not open cited URLs
# WEB_PORT=8080
