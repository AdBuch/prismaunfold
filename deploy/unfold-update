#!/usr/bin/env bash
# ~/bin/unfold-update on the server "unfold" (install: docs/RELEASE.md).
#
#   unfold-update                  deploy the newest release tag on main
#   unfold-update vX.Y.Z           deploy this release (must be on main, CI green)
#   unfold-update rollback         back to the previously deployed version
#   unfold-update verify | status  checks only / show deployments
#
# Only verified releases reach production. The deployment logic is
# scripts/deploy-release.sh *of the release being deployed*, read straight from
# git, so the first switch away from an old checkout works and the procedure is
# always the reviewed one from main.
set -Eeuo pipefail
export UNFOLD_DIR=${UNFOLD_DIR:-/opt/unfold}
cd "$UNFOLD_DIR"
umask 022
git fetch --quiet --force --tags origin main
latest=$(git tag --merged origin/main --sort=-v:refname --list 'v[0-9]*.[0-9]*.[0-9]*' | head -1)
[[ -n $latest ]] || { echo "No release tag on origin/main" >&2; exit 1; }
case ${1:-} in
  rollback|status|verify|restore-db) tag=$latest; args=("$@") ;;
  ""|v[0-9]*) tag=${1:-$latest}; args=(deploy "$tag" "${@:2}") ;;
  -h|--help|*) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac
git merge-base --is-ancestor "refs/tags/$tag^{commit}" origin/main 2>/dev/null \
  || { echo "$tag is not a release on origin/main" >&2; exit 1; }
script=$(mktemp "${TMPDIR:-/tmp}/deploy-release.XXXXXX")
git show "$tag:scripts/deploy-release.sh" > "$script"
PRISMUNFOLD_DEPLOY_COPY=$script exec bash "$script" "${args[@]}"
