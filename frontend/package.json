{
  "name": "prismunfold-frontend",
  "version": "0.2.0",
  "private": true,
  "description": "PrismUnfold newspaper frontend. Reads the pipeline's JSON API; a demo build with fictional fixtures exists for tests",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:demo": "PRISM_CONTENT=demo node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node scripts/build.mjs && node scripts/serve.mjs",
    "start:demo": "PRISM_CONTENT=demo node scripts/build.mjs && node scripts/serve.mjs",
    "dev": "node scripts/serve.mjs --watch",
    "test": "node --test --experimental-strip-types \"tests/*.test.ts\"",
    "test:e2e": "node tests/e2e.mjs",
    "test:e2e:api": "node tests/e2e-api.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0",
    "playwright": "^1.50.0"
  }
}
